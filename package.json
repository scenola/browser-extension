{
  "name": "scenola-browser-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint . --format ./tools/lint/formatter.js && node tools/lint/format.js --check && depcruise packages apps --config .dependency-cruiser.cjs && knip",
    "typecheck": "tsc -b",
    "test": "vitest run --configLoader runner",
    "format": "node tools/lint/format.js --write",
    "openapi:sync": "node tools/openapi/sync.ts",
    "openapi:check": "node tools/openapi/sync.ts --check",
    "mock-api": "node tools/mock-api/server.ts --port=8787",
    "dev": "node apps/extension/build/dev.ts",
    "dev:backend": "pnpm --filter @mt/extension dev",
    "build": "pnpm --filter @mt/extension build",
    "size": "pnpm --filter @mt/extension size",
    "e2e": "pnpm --filter @mt/extension e2e",
    "e2e:stack": "pnpm --filter @mt/extension exec playwright test --config e2e-stack/playwright.config.ts",
    "contrast:check": "node tools/contrast/contrast-check.ts",
    "i18n:compile": "node tools/i18n/compile.ts --write",
    "i18n:check": "node tools/i18n/compile.ts --check",
    "dev-key": "node tools/dev-key/generate.ts",
    "module-versions:check": "node tools/gates/module-versions.ts",
    "docs:services": "node tools/docs/services-md.ts",
    "new:service": "node tools/scaffold/new-service.ts",
    "release:zip": "node tools/release/deterministic-zip.ts",
    "verify:install": "node tools/release/verify-install.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "jose": "6.2.12",
    "knip": "6.42.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
